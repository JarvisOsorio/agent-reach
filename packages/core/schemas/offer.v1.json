{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-reach.dev/schemas/offer.v1.json",
  "title": "AgentReachOfferCard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "capabilities", "publisherAgentId"],
  "properties": {
    "schemaVersion": {
      "const": "agent-reach.offer.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url"],
        "properties": {
          "type": {
            "enum": ["http", "mcp", "a2a", "other"]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": {
          "enum": ["free", "per_call", "subscription", "negotiable"]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 8
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "authHints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publisherAgentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
